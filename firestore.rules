rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    match /wishes/{wishId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["name", "message", "createdAt"])
        && validString(request.resource.data.name, 80)
        && validString(request.resource.data.message, 180)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["name", "attendance", "guests", "submittedAt"])
        && validString(request.resource.data.name, 80)
        && request.resource.data.attendance in ["Hadir", "Tidak Hadir"]
        && request.resource.data.guests is int
        && request.resource.data.guests >= 0
        && request.resource.data.guests <= 10
        && request.resource.data.submittedAt is timestamp;
      allow update, delete: if false;
    }
  }
}
